# Open Bench environment configuration.
# Copy this file to .env for local overrides. Never commit .env (it is gitignored).
#
# The app runs with ZERO secrets by default: when no provider key is set,
# AI_PROVIDER falls back to "mock", which returns canned, schema-valid responses.

# Which AI provider to use. One of: mock | bedrock | anthropic
# Default (when unset or no key present): mock
AI_PROVIDER=mock

# Model identifier passed to the live provider (ignored by the mock provider).
# Examples:
#   anthropic -> claude-3-5-sonnet-latest
#   bedrock   -> anthropic.claude-3-5-sonnet-20240620-v1:0
AI_MODEL=

# --- Provider credentials (only needed when AI_PROVIDER is not "mock") ---

# For AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# For AI_PROVIDER=bedrock (standard AWS SDK credential variables)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
